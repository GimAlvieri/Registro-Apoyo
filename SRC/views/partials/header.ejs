<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Municipalidad de Chinchao</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, sans-serif; color: #18312b; background: #f3f7f5; }
    body { margin: 0; }
    header { background: #145b46; color: #fff; padding: 1rem max(1rem, calc((100% - 1100px) / 2)); }
    header a { color: #fff; margin-right: 1rem; text-decoration: none; font-weight: 600; }
    main { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
    h1 { margin-top: 0; }
    .actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .button, button { display: inline-block; border: 0; border-radius: .35rem; padding: .6rem .9rem; background: #176e53; color: #fff; font: inherit; text-decoration: none; cursor: pointer; }
    .button.secondary { background: #526760; }
    .button.danger, button.danger { background: #a52f2f; }
    table { width: 100%; border-collapse: collapse; background: #fff; margin-top: 1rem; }
    th, td { padding: .75rem; border-bottom: 1px solid #d9e4df; text-align: left; }
    th { background: #e5efeb; }
    form label { display: block; margin: 1rem 0 .3rem; font-weight: 600; }
    input, select { box-sizing: border-box; width: 100%; max-width: 34rem; padding: .65rem; border: 1px solid #91a99e; border-radius: .3rem; font: inherit; }
    .errors { color: #8b1f1f; background: #fff0f0; border-left: 4px solid #a52f2f; padding: .75rem 1rem; }
    .card { background: #fff; padding: 1rem; border: 1px solid #d9e4df; border-radius: .4rem; margin: 1rem 0; }
    .muted { color: #526760; }
    @media (max-width: 700px) { table { display: block; overflow-x: auto; } }
  </style>
</head>
<body>
  <header>
    <a href="/beneficiarios">Beneficiarios</a>
    <a href="/solicitudes">Solicitudes de apoyo</a>
  </header>
  <main>
