<%- include("../partials/header", { title: "Solicitudes de apoyo" }) %>
<div class="actions">
  <h1 style="flex: 1">Solicitudes de apoyo</h1>
  <a class="button" href="/solicitudes/nueva">Registrar apoyo</a>
</div>

<% if (!solicitudes.length) { %>
  <p class="card">Todavía no hay apoyos registrados.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Fecha</th><th>Beneficiario</th><th>DNI</th><th>Responsable</th><th>Monto</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% solicitudes.forEach((solicitud) => { %>
        <tr>
          <td><%= new Date(solicitud.fecha_entrega).toLocaleDateString("es-PE", { timeZone: "UTC" }) %></td>
          <td><%= solicitud.beneficiario %></td>
          <td><%= solicitud.dni %></td>
          <td><%= solicitud.responsable || "Sin asignar" %></td>
          <td><%= solicitud.monto_apoyo == null ? "No especificado" : `S/ ${Number(solicitud.monto_apoyo).toFixed(2)}` %></td>
          <td class="actions">
            <a href="/solicitudes/<%= solicitud.id_solicitud %>/editar">Editar</a>
            <form method="post" action="/solicitudes/<%= solicitud.id_solicitud %>/eliminar" onsubmit="return confirm('¿Eliminar este apoyo?')">
              <button class="danger" type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include("../partials/footer") %>
