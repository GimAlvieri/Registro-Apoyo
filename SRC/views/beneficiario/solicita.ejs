<%- include("../partials/header", { title: editing ? "Editar apoyo" : "Registrar apoyo" }) %>
<h1><%= editing ? "Editar apoyo" : "Registrar apoyo" %></h1>

<% if (errors.length) { %>
  <div class="errors" role="alert">
    <ul><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
  </div>
<% } %>

<form method="post" action="<%= editing ? `/solicitudes/${id}/editar` : '/solicitudes' %>">
  <label for="id_beneficiario">Beneficiario *</label>
  <select id="id_beneficiario" name="id_beneficiario" required>
    <option value="">Selecciona un beneficiario</option>
    <% beneficiarios.forEach((beneficiario) => { %>
      <option value="<%= beneficiario.id_beneficiario %>" <%= String(solicitud.id_beneficiario || '') === String(beneficiario.id_beneficiario) ? "selected" : "" %>>
        <%= beneficiario.nombre %> — DNI <%= beneficiario.dni %>
      </option>
    <% }) %>
  </select>

  <label for="monto_apoyo">Monto del apoyo (S/)</label>
  <input id="monto_apoyo" name="monto_apoyo" type="number" min="0" step="0.01" value="<%= solicitud.monto_apoyo ?? '' %>">

  <label for="fecha_entrega">Fecha de entrega *</label>
  <input id="fecha_entrega" name="fecha_entrega" type="date" required value="<%= solicitud.fecha_entrega || '' %>">

  <p class="muted">El monto es opcional; la fecha de entrega es obligatoria.</p>
  <div class="actions">
    <button type="submit"><%= editing ? "Guardar cambios" : "Registrar apoyo" %></button>
    <a class="button secondary" href="<%= editing ? '/solicitudes' : '/beneficiarios' %>">Cancelar</a>
  </div>
</form>
<%- include("../partials/footer") %>