<%- include("../partials/header", { title: "Detalle del beneficiario" }) %>
<h1><%= beneficiario.nombre %></h1>
<section class="card">
  <p><strong>DNI:</strong> <%= beneficiario.dni %></p>
  <p><strong>Celular:</strong> <%= beneficiario.celular || "No registrado" %></p>
  <p><strong>Responsable:</strong> <%= beneficiario.responsable || "Sin asignar" %></p>
  <p><strong>Cargo:</strong> <%= beneficiario.cargo || "—" %></p>
  <div class="actions">
    <a class="button" href="/beneficiarios/<%= beneficiario.id_beneficiario %>/editar">Editar</a>
    <a class="button secondary" href="/solicitudes/nueva?id_beneficiario=<%= beneficiario.id_beneficiario %>">Registrar apoyo</a>
    <form method="post" action="/beneficiarios/<%= beneficiario.id_beneficiario %>/eliminar" onsubmit="return confirm('¿Eliminar este beneficiario?')">
      <button class="danger" type="submit">Eliminar</button>
    </form>
  </div>
</section>

<h2>Apoyos registrados</h2>
<% if (!solicitudes.length) { %>
  <p class="card">Este beneficiario todavía no tiene apoyos registrados.</p>
<% } else { %>
  <table>
    <thead><tr><th>Fecha de entrega</th><th>Monto</th><th>Acción</th></tr></thead>
    <tbody>
      <% solicitudes.forEach((solicitud) => { %>
        <tr>
          <td><%= new Date(solicitud.fecha_entrega).toLocaleDateString("es-PE", { timeZone: "UTC" }) %></td>
          <td><%= solicitud.monto_apoyo == null ? "No especificado" : `S/ ${Number(solicitud.monto_apoyo).toFixed(2)}` %></td>
          <td><a href="/solicitudes/<%= solicitud.id_solicitud %>/editar">Editar</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<%- include("../partials/footer") %>